{
  "name": "Cloth Simulation",
  "description": "Verlet-integrated cloth with structural, shear, and flexion springs. Sphere-cloth collision deforms the mesh. Use the Cloth menu to adjust spring constants, wind, tearing, and burning. Two cameras: overview and close-up.",
  "gravity_on": true,
  "cameras": [
    {
      "name": "MainCam",
      "transform": {
        "position": { "x": 1.0, "y": 7.5, "z": 4.5 },
        "orientation": { "yaw": -90.0, "pitch": -30.0, "roll": 0.0 },
        "scale": { "x": 1.0, "y": 1.0, "z": 1.0 }
      },
      "camera_type_type": "PerspectiveCamera",
      "camera_type": { "fov": 60.0, "near": 0.1, "far": 200.0 }
    },
    {
      "name": "Cloth Close-Up",
      "transform": {
        "position": { "x": 0.8, "y": 2.8, "z": 2.5 },
        "orientation": { "yaw": -90.0, "pitch": -5.0, "roll": 0.0 },
        "scale": { "x": 1.0, "y": 1.0, "z": 1.0 }
      },
      "camera_type_type": "PerspectiveCamera",
      "camera_type": { "fov": 40.0, "near": 0.1, "far": 50.0 }
    }
  ],
  "materials": [
    { "name": "rubber",   "density": 1200.0 },
    { "name": "concrete", "density": 2400.0 }
  ],
  "interactions": [
    {
      "material_a": "rubber",
      "material_b": "concrete",
      "restitution": 0.5,
      "static_friction": 0.4,
      "dynamic_friction": 0.3
    }
  ],
  "objects": [
    {
      "name": "ClothPanel",
      "transform": {
        "position": { "x": 0.0, "y": 3.0, "z": 0.0 },
        "orientation": { "yaw": 0.0, "pitch": 0.0, "roll": 0.0 },
        "scale": { "x": 1.0, "y": 1.0, "z": 1.0 }
      },
      "material": "rubber",
      "shape_type": "Plane",
      "shape": { "normal": { "x": 0.0, "y": 1.0, "z": 0.0 } },
      "behaviour_type": "ClothObject",
      "behaviour": {
        "rows": 30,
        "cols": 30,
        "cell_size": 0.075,
        "spring_k": 200.0,
        "shear_k": 100.0,
        "flexion_k": 50.0,
        "damping": 0.05,
        "particle_mass": 0.05,
        "pin_top_edge": true
      },
      "collision_type": "SOLID",
      "texture_path":    "textures/fabric/Poliigon_BoucleFabricBubbly_7827_Albedo.jpg",
      "normal_map_path": "textures/fabric/Poliigon_BoucleFabricBubbly_7827_Normal.png",
      "ao_path":         "textures/fabric/Poliigon_BoucleFabricBubbly_7827_AmbientOcclusion.jpg",
      "roughness_path":  "textures/fabric/Poliigon_BoucleFabricBubbly_7827_Roughness.jpg",
      "metallic_path":   "textures/black.png"
    },
    {
      "name": "Floor",
      "transform": {
        "position": { "x": 0.0, "y": 0.0, "z": 0.0 },
        "orientation": { "yaw": 0.0, "pitch": 0.0, "roll": 0.0 },
        "scale": { "x": 1.0, "y": 1.0, "z": 1.0 }
      },
      "material": "concrete",
      "shape_type": "Plane",
      "shape": { "normal": { "x": 0.0, "y": 1.0, "z": 0.0 }, "width": 20.0, "depth": 20.0 },
      "behaviour_type": "StaticObject",
      "behaviour": {},
      "collision_type": "SOLID"
    }
  ]
}
