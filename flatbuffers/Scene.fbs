namespace Simulation;

// =======================
// Basic Math Types
// =======================

struct Vec3 {
  x: float;
  y: float;
  z: float;
}

struct RotationEuler {
  yaw: float;   // rotation around Y axis (degrees)
  pitch: float; // rotation around X axis (degrees)
  roll: float;  // rotation around Z axis (degrees)
}

struct PhysicsState {
  linear_velocity: Vec3; // metres/second
  angular_velocity: Vec3; // degrees/second
}

struct Transform {
  position: Vec3;
  orientation: RotationEuler;
  scale: Vec3;
}

struct FloatRange {
  min: float;
  max: float;
}

struct Vec3Range {
  min: Vec3;
  max: Vec3;
}

// =======================
// Cameras
// =======================

union CameraType {
  PerspectiveCamera,
  OrthographicCamera
}

table Camera {
  name: string;
  transform: Transform;
  camera_type: CameraType;
}

table PerspectiveCamera {
  fov: float;
  near: float;
  far: float;
}

table OrthographicCamera {
  size: float;
  near: float;
  far: float;
}

// =======================
// Shapes
// =======================

union Shape {
 Sphere,
 Plane,
 Capsule,
 Cylinder,
 Cuboid
}

table Sphere { radius: float; }
table Plane {
  normal: Vec3;    // local-space normal, rotated by object transform
  width:  float = 20.0;  // visual mesh extent along X (does not affect physics — PlaneCollider is infinite)
  depth:  float = 20.0;  // visual mesh extent along Z
}
table Capsule { radius: float; height: float; }
table Cylinder { radius: float; height: float; }
table Cuboid { size: Vec3; }

// =======================
// Behaviour
// =======================

table ClothObject {
  rows:            int   = 10;
  cols:            int   = 10;
  cell_size:       float = 0.2;
  spring_k:        float = 100.0;
  shear_k:         float = 50.0;
  flexion_k:       float = 25.0;
  damping:         float = 0.1;
  particle_mass:   float = 0.1;
  pin_top_edge:    bool  = true;
}

// Spawns agent_count flocking agents around the object's transform position.
// The object's own transform.position is used as the spawn-sphere centre.
table FlockAgent {
  agent_count:       int   = 60;
  sphere_radius:     float = 0.3;
  separation_radius: float = 1.5;
  alignment_radius:  float = 3.0;
  cohesion_radius:   float = 5.0;
  w_separation:      float = 2.0;
  w_alignment:       float = 1.0;
  w_cohesion:        float = 1.0;
  max_speed:         float = 6.0;
  max_force:         float = 15.0;
  spawn_radius:      float = 5.0;
}

union Behaviour {
  StaticObject,
  SimulatedObject,
  AnimatedObject,
  ClothObject,
  FlockAgent
}

table StaticObject {
}

enum EasingType : byte { LINEAR, SMOOTHSTEP }
enum PathMode : byte { STOP, LOOP, REVERSE }

enum ObjectOwnerType : byte { ONE, TWO, THREE, FOUR }

table Waypoint {
  position: Vec3;
  rotation: RotationEuler;
  time: float; // absolute time to reach this waypoint
}

table AnimatedObject {
  waypoints: [Waypoint];
  total_duration: float;
  easing: EasingType;
  path_mode: PathMode;
}

table SimulatedObject {
  initial_state: PhysicsState;
  
  owner: ObjectOwnerType;
  
}

// =======================
// Object Definition
// =======================

enum CollisionType : byte {
  SOLID, // normal object (outside is empty, inside is solid)
  CONTAINER // inverted (inside is empty, outside is solid)
}

table Object {
  name: string;
  transform: Transform;
  material: string;
  shape: Shape;
  behaviour: Behaviour;
  collision_type: CollisionType = SOLID;
  script_type: string;   // optional C++ script class name attached to this entity (e.g. "PlayerController")
  parent: string;        // optional name of parent Object; null = root entity
}

// =======================
// Materials
// =======================

table Material {
  name: string;
  density: float;
}

table MaterialInteraction {
  material_a: string;
  material_b: string;
  restitution: float;
  static_friction: float;
  dynamic_friction: float;
}

// =======================
// Spawning
// =======================

union SpawnType {
  SingleBurstSpawn,
  RepeatingSpawn
}

union SpawnLocation {
  FixedLocation,
  RandomBox,
  RandomSphere
}

table RepeatingSpawn {
  interval: float;
  max_count: uint;
}

table SingleBurstSpawn {
  count: uint;
}

table FixedLocation {
  transform: Transform;
}

table RandomBox {
  min: Vec3;
  max: Vec3;
}

table RandomSphere {
  center: Vec3;
  radius: float;
}

enum SpawnerOwnerType : byte { ONE, TWO, THREE, FOUR, SEQUENTIAL }

table BaseSpawner {
  name: string;
  start_time: float = 0; // time (seconds) when spawning starts
  spawn_type: SpawnType;
  location: SpawnLocation;
  linear_velocity: Vec3Range; // initial linear velocity range (metres/second)
  angular_velocity: Vec3Range; // initial angular velocity range (degrees/second)
  material: string; // material name for spawned objects
  owner: SpawnerOwnerType;
}

table SphereSpawner {
  base: BaseSpawner;
  radius_range: FloatRange;
}

table CylinderSpawner {
  base: BaseSpawner;
  radius_range: FloatRange;
  height_range: FloatRange;
}

table CapsuleSpawner {
  base: BaseSpawner;
  radius_range: FloatRange;
  height_range: FloatRange;
}

table CuboidSpawner {
  base: BaseSpawner;
  size_range: Vec3Range;
}

union SpawnerType {
  SphereSpawner,
  CylinderSpawner,
  CapsuleSpawner,
  CuboidSpawner
}

// =======================
// Scene
// =======================

table Scene {
  name: string;
  description: string;
  gravity_on: bool = true;
  cameras: [Camera];
  objects: [Object];
  spawners: [SpawnerType];
  materials: [Material];
  interactions: [MaterialInteraction];
}

root_type Scene;